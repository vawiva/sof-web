+/*
+ * browser port: a browser cannot open UDP sockets. Datagrams of the client
+ * to other hosts are handed to the page (Module.netSend), which carries each
+ * one as a single WebSocket message to the gateway configured for the page;
+ * the gateway forwards it over UDP to an allowed game server and returns the
+ * server's datagrams the same way (Module.netRecv). Addresses keep their
+ * meaning: the engine still talks to <server ip>:<port>.
+ */
+EM_JS(void, browser_net_send, (const unsigned char *ip, int port, const unsigned char *data, int len), {
+	if (Module['netSend'])
+	{
+		Module['netSend'](HEAPU8.slice(ip, ip + 4), port, HEAPU8.slice(data, data + len));
+	}
+});
+
+/* one received datagram: its length, -1 when none is waiting, -2 when it does not fit */
+EM_JS(int, browser_net_recv, (unsigned char *ip, int *port, unsigned char *data, int max), {
+	if (!Module['netRecv'])
+	{
+		return -1;
+	}
+	var p = Module['netRecv']();
+	if (!p)
+	{
+		return -1;
+	}
+	if (p.data.length > max)
+	{
+		return -2;
+	}
+	HEAPU8.set(p.ip, ip);
+	HEAP32[port >> 2] = p.port;
+	HEAPU8.set(p.data, data);
+	return p.data.length;
+});
+#endif
+
