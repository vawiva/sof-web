diff --git a/engine/src/backends/unix/shared/hunk.c b/engine/src/backends/unix/shared/hunk.c
index eebb49c..d08783e 100644
--- a/engine/src/backends/unix/shared/hunk.c
+++ b/engine/src/backends/unix/shared/hunk.c
@@ -50,6 +50,63 @@ byte *membase;
 size_t maxhunksize;
 size_t curhunksize;
 
+#ifdef __EMSCRIPTEN__
+/* Emscripten has no real mremap/munmap of anonymous mappings, so the hunk is a plain
+   heap block. Callers size their hunks close to actual use (models.c, gl3_model.c), so not
+   shrinking in Hunk_End costs little. */
+#include <stdlib.h>
+
+void *
+Hunk_Begin(int maxsize)
+{
+	maxhunksize = maxsize + sizeof(size_t) + 32;
+	curhunksize = 0;
+	membase = (byte *)calloc(1, maxhunksize);
+
+	if (membase == NULL)
+	{
+		Sys_Error("unable to allocate %d bytes", maxsize);
+	}
+
+	*((size_t *)membase) = curhunksize;
+	return membase + sizeof(size_t);
+}
+
+void *
+Hunk_Alloc(int size)
+{
+	byte *buf;
+
+	size = (size + 31) & ~31;
+
+	if (curhunksize + size > maxhunksize)
+	{
+		Sys_Error("%s: overflow %d > %d", __func__, curhunksize + size, maxhunksize);
+	}
+
+	buf = membase + sizeof(size_t) + curhunksize;
+	curhunksize += size;
+	return buf;
+}
+
+int
+Hunk_End(void)
+{
+	*((size_t *)membase) = curhunksize + sizeof(size_t);
+	return curhunksize;
+}
+
+void
+Hunk_Free(void *base)
+{
+	if (base)
+	{
+		free(((byte *)base) - sizeof(size_t));
+	}
+}
+
+#else /* !__EMSCRIPTEN__ */
+
 void *
 Hunk_Begin(int maxsize)
 {
@@ -172,3 +229,4 @@ Hunk_Free(void *base)
 	}
 }
 
+#endif /* __EMSCRIPTEN__ */
