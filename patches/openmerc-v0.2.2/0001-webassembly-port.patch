 void
 CL_RequestCinematicSkip(void)
 {
 	skip_requested = true;
+#ifdef __EMSCRIPTEN__
+	skip_realtime = cls.realtime ? cls.realtime : 1;
+#endif
+}
+
+#ifdef __EMSCRIPTEN__
+/* browser port: Esc presses that belong to a skip already made - repeated taps of a touch Menu button or of a
+   controller's Start while the cinematic ends and the next map loads - must not open the main menu over the next
+   level (which pauses it and looks like a hang). Swallowed: within 2 s of a skip request, and while a single-player
+   level is loading after one (a local server with one player slot). */
+qboolean
+CL_SkipEscapeSwallowed(void)
+{
+	if (!skip_realtime)
+	{
+		return false;
+	}
+
+	if (cls.realtime - skip_realtime < 2000)
+	{
+		return true;
+	}
+
+	if ((cls.state != ca_active) && (cls.state >= ca_connecting) && Com_ServerState() &&
+		(Cvar_VariableValue("maxclients") <= 1) && (cls.realtime - skip_realtime < 30000))
+	{
+		return true;
+	}
+
+	skip_realtime = 0;
+	return false;
 }
+#endif
 
