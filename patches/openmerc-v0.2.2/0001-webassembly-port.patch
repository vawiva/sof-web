+	while (sock == NS_CLIENT)
+	{
+		int port = 0, n;
+
+		n = browser_net_recv(net_from->ip, &port, net_message->data, net_message->maxsize);
+
+		if (n == -2)
+		{
+			Com_Printf("Oversize packet from the network gateway\n");
+			continue;
+		}
+
+		if (n < 0)
