+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+/* The browser owns the loop: Qcommon_Frame runs from the animation-frame callback and keeps its
+   own usec-based timing, so the simulation (10 Hz server frames, msec-based movement) does not depend
+   on the display rate.
+   - Module.frameCap (set by the page, 0 = every display frame): a frame-rate target. Frames follow a
+     schedule advanced by 1/cap per frame (not reset to "now"), so the average rate is the cap even when
+     the display interval does not divide it (144 Hz with a cap of 60 runs 3, 2, 3, 2 ... display frames).
+   A hidden tab gets no animation frames; the engine's own timing already keeps the world from
+   fast-forwarding afterwards (measured: work/tools/pw/resume-check.mjs). */
+
+static long long em_oldtime;
+static double em_next;
+
+static void
+Qcommon_EmFrame(void)
+{
+	double cap = EM_ASM_DOUBLE({ return Module['frameCap'] || 0; });
+	long long newtime;
+
+	if (cap > 0)
+	{
+		double now = emscripten_get_now();
+
+		if ((em_next == 0) || (now - em_next > 250))
+		{
+			em_next = now; /* first frame, or after a stall: restart the schedule */
+		}
+
+		if (now < em_next - 2.0) /* 2 ms tolerance for animation-frame jitter */
+		{
+			return;
+		}
+
+		em_next += 1000.0 / cap;
+	}
+
+	newtime = Sys_Microseconds();
+	curtime = (int)(newtime / 1000ll);
+	Qcommon_Frame(newtime - em_oldtime);
+	em_oldtime = newtime;
+}
+
+static void
+Qcommon_Mainloop(void)
+{
+	em_oldtime = Sys_Microseconds();
+	emscripten_set_main_loop(Qcommon_EmFrame, 0, 1);
+}
+#else
