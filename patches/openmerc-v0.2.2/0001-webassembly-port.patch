--- a/tools/build/OMModuleExports.cmake
+++ b/tools/build/OMModuleExports.cmake
@@ -5,6 +5,12 @@
 # always bind inside the module, never to same-named symbols of the engine executable or another module.
 # (Linux build, docs/BUILD-linux.md)
 function(om_elf_module_exports target deffile)
+  if(EMSCRIPTEN)
+    # Emscripten side module, loaded by the engine with dlopen
+    set_target_properties(${target} PROPERTIES SUFFIX ".so")
+    target_link_options(${target} PRIVATE -sSIDE_MODULE=1)
+    return()
+  endif()
   if(WIN32 OR APPLE)
     return()
   endif()
